# EduRoute AI settings for an NVIDIA GPU server.
# setup.sh copies this to the project's .env (never committed). Edit there.

# --- Text LLM: Ollama on this server ---
EDUROUTE_LLM_BACKEND=openai_compatible
EDUROUTE_LLM_BASE_URL=http://127.0.0.1:11434/v1
EDUROUTE_LLM_MODEL=qwen2.5:3b
EDUROUTE_LLM_API_KEY=
EDUROUTE_LLM_TIMEOUT=180
EDUROUTE_TEMPERATURE=0.3
EDUROUTE_MAX_NEW_TOKENS=512

# --- Vision: same Ollama server. The image benchmark runs both 3B and 7B. ---
EDUROUTE_VISION_BASE_URL=http://127.0.0.1:11434/v1
EDUROUTE_VISION_MODEL=qwen2.5vl:3b
EDUROUTE_VISION_API_KEY=
EDUROUTE_VISION_TIMEOUT=300

# --- Retrieval: the 26-group engineering index (36,367 passages) ---
EDUROUTE_RAG_VERSION=engineering_v1
EDUROUTE_RETRIEVAL_MODE=dense

# --- Verification: NLI contradiction check (cheap on a GPU) ---
EDUROUTE_NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall

# --- Voice: Whisper on the GPU ---
EDUROUTE_WHISPER_MODEL=base.en
EDUROUTE_WHISPER_DEVICE=cuda
EDUROUTE_WHISPER_COMPUTE_TYPE=float16
EDUROUTE_WHISPER_BEAM=1
EDUROUTE_TTS_VOICE=en-IN-NeerjaNeural

# --- Privacy (report §21): keep false unless participants consented ---
EDUROUTE_LOG_QUERY_TEXT=false
EDUROUTE_LOG_RETENTION_DAYS=30
