# Streamlit Community Cloud: paste these into the app's "Secrets" box
# (Settings -> Secrets). Root-level secrets become environment variables,
# which config/settings.py reads. Never commit a real secrets.toml.

# Language model endpoint: the https URL printed by
# colab/EduRoute_Colab_Model_Server.ipynb (changes every Colab session).
# Leave it unreachable and the app runs in labelled extractive mode.
EDUROUTE_LLM_BASE_URL = "https://<your-tunnel>.trycloudflare.com/v1"
EDUROUTE_LLM_MODEL = "qwen2.5:3b"

# Optional image questions through the same endpoint
EDUROUTE_VISION_BASE_URL = "https://<your-tunnel>.trycloudflare.com/v1"
EDUROUTE_VISION_MODEL = "qwen2.5vl:3b"

# Hosted app: no evaluation studio (it writes files), no NLI model (memory)
EDUROUTE_ENABLE_STUDIO = "false"
EDUROUTE_NLI_MODEL = ""
EDUROUTE_LOG_RETENTION_DAYS = "30"
EDUROUTE_LOG_QUERY_TEXT = "false"
