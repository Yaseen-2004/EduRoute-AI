# Copy to .env and adjust. Never commit .env (it may hold API keys).

# --- Text LLM (Qwen2.5-3B-Instruct) ---
# openai_compatible: Ollama locally, or vLLM / any OpenAI-style server (e.g. on Colab)
# transformers:      load the model in-process (needs a GPU to be practical)
# extractive:        no model; evidence sentences only (offline demo / tests)
EDUROUTE_LLM_BACKEND=openai_compatible

# Ollama on this machine:   ollama pull qwen2.5:3b
EDUROUTE_LLM_BASE_URL=http://localhost:11434/v1
EDUROUTE_LLM_MODEL=qwen2.5:3b
# vLLM example:  EDUROUTE_LLM_BASE_URL=https://<your-tunnel>/v1
#                EDUROUTE_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
EDUROUTE_LLM_API_KEY=

EDUROUTE_TEMPERATURE=0.3
EDUROUTE_MAX_NEW_TOKENS=512

# --- Vision model (leave empty to disable image questions) ---
# Ollama:  ollama pull qwen2.5vl:3b
EDUROUTE_VISION_BASE_URL=
EDUROUTE_VISION_MODEL=
EDUROUTE_VISION_API_KEY=

# --- Retrieval ---
EDUROUTE_RAG_VERSION=v4
EDUROUTE_RETRIEVAL_MODE=dense

# --- Voice ---
EDUROUTE_WHISPER_MODEL=base.en
EDUROUTE_TTS_VOICE=en-IN-NeerjaNeural

# --- Privacy (report §21) ---
# Keep false unless participants consented to question logging.
EDUROUTE_LOG_QUERY_TEXT=false

# Optional NLI contradiction check in verification (recommended on a GPU)
# EDUROUTE_NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
EDUROUTE_NLI_MODEL=
